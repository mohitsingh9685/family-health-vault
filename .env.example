# Local Docker Compose PostgreSQL service.
POSTGRES_USER="family_health_vault"
POSTGRES_PASSWORD="replace-with-a-local-development-password"
POSTGRES_DB="family_health_vault"

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js production configuration.
# Generate a strong random value; never reuse this placeholder.
AUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_URL="https://your-production-domain.example"

# Private S3 configuration used only by server-side upload/view routes.
AWS_REGION="your-aws-region"
AWS_ACCESS_KEY_ID="replace-with-a-restricted-iam-access-key"
AWS_SECRET_ACCESS_KEY="replace-with-a-restricted-iam-secret-key"
AWS_S3_BUCKET_NAME="your-private-medical-record-bucket"
