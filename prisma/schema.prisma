generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            Profile?
  familyMemberships  FamilyMember[]
  familyInvitations  FamilyInvitation[]
  medicalRecords     MedicalRecord[]
  healthMeasurements HealthMeasurement[]

  // New appointment relations
  createdAppointments Appointment[] @relation("CreatedAppointments")
  patientAppointments Appointment[] @relation("PatientAppointments")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Family {
  id                    String                    @id @default(uuid())
  name                  String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  members               FamilyMember[]
  invitations           FamilyInvitation[]
  medicalRecordAccesses MedicalRecordAccess[]
  measurementAccesses   HealthMeasurementAccess[]
  appointments          Appointment[]
}

model FamilyMember {
  id        String     @id @default(uuid())
  userId    String
  familyId  String
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model FamilyInvitation {
  id              String    @id @default(uuid())
  familyId        String
  invitedByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model MedicalRecord {
  id               String                       @id @default(uuid())
  userId           String
  title            String
  type             MedicalRecordType
  description      String?
  storageKey       String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  uploadStatus MedicalRecordUploadStatus @default(PENDING)
  processingStatus MedicalRecordProcessingStatus @default(PENDING)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accesses MedicalRecordAccess[]

  @@index([userId])
  @@index([userId, createdAt])
}

model MedicalRecordAccess {
  id              String                    @id @default(uuid())
  medicalRecordId String
  familyId        String
  accessLevel     MedicalRecordAccessLevel  @default(VIEWER)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  medicalRecord MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  family        Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([medicalRecordId, familyId])
  @@index([familyId])
  @@index([medicalRecordId])
}

model HealthMeasurement {
  id        String                 @id @default(uuid())
  userId    String
  type      HealthMeasurementType

  value     Decimal?
  unit      String?
  systolic  Int?
  diastolic Int?

  context    String?
  measuredAt DateTime
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accesses HealthMeasurementAccess[]

  @@index([userId, type])
  @@index([userId, measuredAt])
  @@index([userId, type, measuredAt])
}

model LoginRateLimit {
  key             String    @id
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model HealthMeasurementAccess {
  id            String                    @id @default(uuid())
  measurementId String
  familyId      String
  accessLevel   MedicalRecordAccessLevel  @default(VIEWER)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  measurement HealthMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  family      Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([measurementId, familyId])
  @@index([familyId])
  @@index([measurementId])
}

enum FamilyRole {
  OWNER
  MEMBER
}

enum MedicalRecordType {
  PRESCRIPTION
  BLOOD_REPORT
  DISCHARGE_SUMMARY
  XRAY
  MRI
  CT_SCAN
  LAB_REPORT
  OTHER
}

enum MedicalRecordProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MedicalRecordAccessLevel {
  OWNER
  VIEWER
}

enum HealthMeasurementType {
  BLOOD_SUGAR
  BLOOD_PRESSURE
  WEIGHT
  TEMPERATURE
  HEART_RATE
  OXYGEN_SATURATION
  OTHER
}

enum MedicalRecordUploadStatus {
  PENDING
  UPLOADED
  FAILED
}

// ============================================================
// Appointment Management
// User can create appointments for themselves or another
// family member. Status controls whether it appears as upcoming.
// ============================================================

model Appointment {
  id String @id @default(uuid())

  // [Appointment → Family]
  // Every appointment is isolated to the family where it was created.
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // [Appointment → Creator]
  // User who created this appointment.
  createdById String
  createdBy User @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: Cascade)

  // [Appointment → Patient]
  // User who will attend the appointment.
  patientId String
  patient User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  hospitalName String
  hospitalAddress String?
  doctorName String?

  appointmentDate DateTime
  timeZone       String   @default("Asia/Kolkata")

  // [Appointment → Status]
  // VISITED appointments are excluded from Home → Upcoming Appointments.
  status AppointmentStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, appointmentDate])
  @@index([createdById])
  @@index([patientId])
}

enum AppointmentStatus {
  UPCOMING
  VISITED
}