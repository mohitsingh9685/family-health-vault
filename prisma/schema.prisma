generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  passwordHash      String

  // [User → Profile]
  // One authentication account owns one personal profile.
  profile           Profile?

  // [User → FamilyMember]
  familyMemberships FamilyMember[]

  // [User → FamilyInvitation]
  familyInvitations FamilyInvitation[]
}

model Profile {
  // [Profile]
  // Stores personal information separately from authentication data.
  id          String   @id @default(uuid())
  userId      String   @unique
  name        String
  dateOfBirth DateTime?
  gender      String?
  phone       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

// [Profile → User]
// Deleting the user also removes their profile.
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
}

model Family {
  id          String             @id @default(uuid())
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id        String     @id @default(uuid())
  userId    String
  familyId  String
  createdAt DateTime   @default(now())
  role      FamilyRole @default(MEMBER)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model FamilyInvitation {
  id              String    @id @default(uuid())
  familyId        String
  invitedByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  // [FamilyInvitation → Family]
  // The invitation belongs to a specific family.
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  // [FamilyInvitation → User]
  // Tracks which family owner created the invitation.
  invitedBy User @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

enum FamilyRole {
  OWNER
  MEMBER
}